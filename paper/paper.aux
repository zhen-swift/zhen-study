\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The privilege gap H6 predicted is 0.10 warm and $-0.20$ cold against a pre-declared 0.25, so H6 is refuted in both arms --- and the template that refutes it is not a better scanner but a slower one.} \texttt  {-T3}, \texttt  {-T4} and \texttt  {-T5} behave exactly as the mechanism predicts, at 0.40 in 321 of 333 warm runs; \texttt  {-T2} reaches 0.90 warm and 1.00 cold by running for a median 24 minutes and collecting closed-port resets while it waits.}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:recall}{{3}{8}{\textbf {The privilege gap H6 predicted is 0.10 warm and $-0.20$ cold against a pre-declared 0.25, so H6 is refuted in both arms --- and the template that refutes it is not a better scanner but a slower one.} \texttt {-T3}, \texttt {-T4} and \texttt {-T5} behave exactly as the mechanism predicts, at 0.40 in 321 of 333 warm runs; \texttt {-T2} reaches 0.90 warm and 1.00 cold by running for a median 24 minutes and collecting closed-port resets while it waits}{figure.3}{}}
