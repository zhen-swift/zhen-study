\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {The shipped declaration budget expires before the segment's slowest host answers, and the replies that arrive inside the process's own lifetime are never attributed.} (a) Every split-budget configuration's discovery stage closes at 317--406\,ms against responders measured at 508\,ms; only the shared-budget ablation, at 987--1{,}666\,ms, outlives the tail it must cover. (b) For the one condition whose process outlives that tail sixfold, the capture records the same thirteen echo replies warm and cold and the sweep attributes eight in both --- yet the artifact reports eleven hosts warm and nine cold.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:budget}{{4}{9}{\textbf {The shipped declaration budget expires before the segment's slowest host answers, and the replies that arrive inside the process's own lifetime are never attributed.} (a) Every split-budget configuration's discovery stage closes at 317--406\,ms against responders measured at 508\,ms; only the shared-budget ablation, at 987--1{,}666\,ms, outlives the tail it must cover. (b) For the one condition whose process outlives that tail sixfold, the capture records the same thirteen echo replies warm and cold and the sweep attributes eight in both --- yet the artifact reports eleven hosts warm and nine cold}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces The declaration budget, read off the record. \emph  {echo wire} is ICMP echo replies in the run's own capture, \emph  {attr.}\ what the discovery stage attributed, \emph  {rep.}\ what the artifact reported, \emph  {slow} how many of the two 500\,ms responders were found on average. Warm runs put \emph  {zero} ARP replies on the wire and still report both slow hosts: the neighbour table already held them.}}{9}{table.4}\protected@file@percent }
\newlabel{tab:budget}{{IV}{9}{The declaration budget, read off the record. \emph {echo wire} is ICMP echo replies in the run's own capture, \emph {attr.}\ what the discovery stage attributed, \emph {rep.}\ what the artifact reported, \emph {slow} how many of the two 500\,ms responders were found on average. Warm runs put \emph {zero} ARP replies on the wire and still report both slow hosts: the neighbour table already held them}{table.4}{}}
