<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Study 2's job runner. Runs as zhenstudy with nobody logged in. Installed by v2/runner/install.sh. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.zhen.study2.runner</string>
  <key>UserName</key>
  <string>zhenstudy</string>
  <key>GroupName</key>
  <string>staff</string>
  <key>Umask</key>
  <integer>2</integer>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/Shared/zhen-study2/repo/v2/runner/runner.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/zhenstudy</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <!-- Interactive, not Background (changed 2026-11-19, S1). Background puts the runner and everything it starts in
       macOS background policy (darwinbg, priority 4): CPU last, I/O throttled, and timers coalesced late by up to
       half their interval (~10 ms cap). The testbed's VMs inherited that and netem delays came back 10 ms late; the
       scanners under test would inherit it too. A study that measures timing runs with no resource limits. -->
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/Users/Shared/zhen-study2/logs/runner.launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/Shared/zhen-study2/logs/runner.launchd.err</string>
</dict>
</plist>
